{
  "name": "approve-pull-request-action",
  "private": true,
  "version": "2.1.0",
  "license": "MIT",
  "description": "GitHub Action for approving pull requests",
  "repository": "juliangruber/approve-pull-request-action",
  "scripts": {
    "test": "standard index.js test/*.js && node --test",
    "build": "ncc build index.js",
    "version": "npm run build && git add dist",
    "release": "np",
    "postversion": "git tag --force v2"
  },
  "np": {
    "publish": false
  },
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "np": "^12.1.1",
    "standard": "^17.1.2"
  },
  "overrides": {
    "external-editor": {
      "tmp": "^0.2.7"
    },
    "ignore-walk": {
      "minimatch": "^11.0.1"
    }
  }
}
